DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# Comma-separated origins allowed to call the API (your Vercel URL in production).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Both geocoders require a User-Agent that identifies the application.
# Put your real repo URL or contact address here -- a placeholder domain like
# example.com gets the request rejected with 403.
GEOCODER_USER_AGENT=ELDTripPlanner/1.0 (+https://github.com/YOURNAME/eld-trip-planner)
# Optional -- defaults to local SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/eld
